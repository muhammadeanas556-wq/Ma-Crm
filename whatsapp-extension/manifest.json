{
  "manifest_version": 3,
  "name": "MA CRM WhatsApp",
  "version": "1.0.0",
  "description": "Sends MA CRM order confirmations through the WhatsApp Web tab that is already logged in in this browser. Never opens another browser.",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "tabs",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*",
    "https://web.whatsapp.com/*",
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "js": [
        "whatsapp.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://localhost:3000/*",
        "http://127.0.0.1:3000/*"
      ],
      "js": [
        "crm.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html"
}
