# Copy to .env for LOCAL use only. On Render, set these in Environment (never commit real values).
NODE_ENV=production
TZ=Asia/Karachi

# First start only: creates the first admin on an EMPTY database
ADMIN_NAME=CRM Admin
ADMIN_EMAIL=your-private-email@example.com
ADMIN_PASSWORD=choose-a-strong-unique-password-at-least-12-chars

# Supabase (permanent storage). DATABASE_URL = Session pooler string. Empty = local SQLite.
DATABASE_URL=
SUPABASE_URL=https://YOUR-PROJECT-ID.supabase.co
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=crm-files

# Optional
GEMINI_API_KEY=
WA_BRIDGE_TOKEN=

# ── Multi-Model Image Extraction (Place Order → Add Client → Upload Image) ──
# Every provider below is OPTIONAL and independent: leave a key empty and that
# provider is skipped automatically. Gemini (above) + NVIDIA are tried first
# via the existing fallback chain; any of these that are configured are then
# used automatically, scored, and routed by ai-router.js. No manual model
# selection is ever shown to the user — the CRM picks for them.
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=

NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/muse-glimmer-30b
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

GROQ_API_KEY=
GROQ_MODEL=llama-3.2-90b-vision-preview
GROQ_BASE_URL=https://api.groq.com/openai/v1

MISTRAL_API_KEY=
MISTRAL_MODEL=pixtral-12b-2409
MISTRAL_BASE_URL=https://api.mistral.ai/v1

LLM7_API_KEY=
LLM7_MODEL=gpt-4o-mini
LLM7_BASE_URL=https://api.llm7.io/v1

ZAI_API_KEY=
ZAI_MODEL=glm-4.6v-flash
ZAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4

CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_MODEL=@cf/llava-hf/llava-1.5-7b-hf

KILO_API_KEY=
KILO_MODEL=gpt-4o-mini
KILO_BASE_URL=https://api.kilo.ai/api/gateway
